# Telegram MTProto credentials (https://my.telegram.org → API development tools)
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef
# Telethon StringSession for a user account that is a member of the channel.
SESSION_STRING=1BQANOTEuMTA4LjU2LjE...

# Old channel — the sole intake since Wave 5. The numeric id is canonical;
# the URL is an optional fallback used when a fresh session cannot resolve
# the bare id.
TELEGRAM_OLD_CHANNEL_ID=-1009876543210
# TELEGRAM_OLD_CHANNEL_URL=https://t.me/your_old_channel

# Next.js app — the only data path. No DATABASE_URL here on purpose.
NEXT_BASE_URL=https://your-app.vercel.app
INTERNAL_API_SECRET=change-me-same-value-as-in-the-next-app

# Optional tuning
# How many recent old-channel messages /reconcile scans per run.
RECONCILE_LIMIT=50
# How many *missing* messages it will actually ingest per run — each one
# costs a Gemini call. Raise this (and RECONCILE_LIMIT) for the one-time full
# rebuild — see README.
RECONCILE_INGEST_LIMIT=20
# Photos above this size are skipped (the recipe is still ingested without one).
MAX_PHOTO_BYTES=5242880
HTTP_TIMEOUT_SECONDS=60
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

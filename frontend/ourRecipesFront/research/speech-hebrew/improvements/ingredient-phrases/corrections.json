[
  {"id":"c01","text":"עוד לא שמתי שמן זית. שמתי שמן קנולה.","anchors":["עוד לא","שמן זית","שמן קנולה"]},
  {"id":"c02","text":"רגע, זה פלפל אדום. פלפל שחור עוד לא הוספתי.","anchors":["פלפל אדום","פלפל שחור","עוד לא","הוספתי"]},
  {"id":"c03","text":"שמתי שמן קנולה במקום חמאה.","anchors":["שמתי","שמן קנולה","במקום","חמאה"]},
  {"id":"c04","text":"לא רוטב עגבניות, רוטב סויה.","anchors":["לא","רוטב עגבניות","רוטב סויה"]},
  {"id":"c05","text":"הוספתי רוטב סויה וקצת פלפל לבן.","anchors":["הוספתי","רוטב סויה","פלפל לבן"]},
  {"id":"c06","text":"אמרתי זיתים, לא הוספתי שמן.","anchors":["אמרתי","זיתים","לא","הוספתי","שמן"]}

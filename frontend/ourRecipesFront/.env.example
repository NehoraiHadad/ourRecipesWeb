# =============================================================================
# Our Recipes — Next.js app (Vercel)
#
# The final list per docs/architecture/ARCHITECTURE.md §7, reconciled against
# every `process.env.*` read in `src/`. Nothing here is unused; nothing used is
# missing. See docs/architecture/DEPLOYMENT.md for where each value comes from.
#
# Everything under "Required" must be set for a working deployment.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Managed PostgreSQL — the source of truth (ARCHITECTURE §2).
# Neon / Supabase / Vercel Postgres. Pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# HS256 signing key for the session JWT (src/lib/auth/session.ts).
# Generate: openssl rand -base64 48
JWT_SECRET=

# Telegram Bot API token from @BotFather. Used for the webhook, the outgoing
# mirror, getChatMember (edit permissions) and login HMAC verification.
TELEGRAM_BOT_TOKEN=

# `secret_token` passed to setWebhook; every delivery is rejected unless the
# X-Telegram-Bot-Api-Secret-Token header matches (src/lib/internal/auth.ts).
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Main channel — where recipes are published and mirrored to.
TELEGRAM_CHANNEL_ID=-1001234567890

# Old channel — raw input only; posts here are reformatted by Gemini and
# republished to the main channel by the webhook handler.
TELEGRAM_OLD_CHANNEL_ID=-1009876543210

# Gemini API key (suggest / reformat / refine / optimize-steps / menu preview).
GOOGLE_API_KEY=

# Separate, billing-enabled Gemini key for the infographic model
# ("Nano Banana Pro"). Falls back to GOOGLE_API_KEY when unset, but that model
# is not available on the free tier.
GOOGLE_API_KEY_NANO_BANANA=

# KIE.ai API key — recipe image + infographic generation
# (POST /api/recipes/generate-image, /generate-infographic). Both routes
# return 500 without it. https://kie.ai
KIE_API_KEY=

# Vercel Blob read/write token — recipe images (ARCHITECTURE §5).
# Read implicitly by `@vercel/blob`'s `put()`; on Vercel it is injected by the
# Blob store integration, so set it by hand only for local development.
BLOB_READ_WRITE_TOKEN=

# Shared secret for the machine-to-machine surface: /api/internal/* (called by
# api-python) and manual /api/cron/* triggering. Must equal the api-python
# INTERNAL_API_SECRET. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# Bot username the Telegram Login Widget is rendered for (no @).
# Public by design — it ships to the browser.
NEXT_PUBLIC_TELEGRAM_BOT=your_bot_username

# --- Cron ---------------------------------------------------------------------

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to the scheduled
# GET /api/cron/reconcile (see vercel.json). Set it in the Vercel project;
# without it the cron run is rejected unless INTERNAL_API_SECRET is used.
CRON_SECRET=

# Base URL of the deployed api-python function (with or without the trailing
# /reconcile). Optional: when unset, the cron still retries pending Telegram
# mirrors and only skips the MTProto history pass.
# PYTHON_RECONCILE_URL=https://your-reconcile-function.vercel.app

# --- Optional -----------------------------------------------------------------

# Pino log level. Defaults to `debug` in development, `info` otherwise.
# LOG_LEVEL=info

# Override the KIE model id used for recipe images / infographics. Defaults
# to `nano-banana-2` / `nano-banana-pro`. A Hebrew side-by-side against
# `gpt-image-2-text-to-image` is pending (4x cheaper if Hebrew renders well) —
# set these once that A/B locks in a different model.
# KIE_IMAGE_MODEL=nano-banana-2
# KIE_INFOGRAPHIC_MODEL=nano-banana-pro

# NODE_ENV and VERCEL_GIT_COMMIT_SHA are also read (logger, dev-only branches)
# but are supplied by Next.js / Vercel — do not set them here.

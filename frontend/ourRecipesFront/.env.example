# =============================================================================
# Our Recipes — Next.js app (Vercel)
#
# The final list per docs/architecture/ARCHITECTURE.md §7, reconciled against
# every `process.env.*` read in `src/`. Nothing here is unused; nothing used is
# missing. See docs/architecture/DEPLOYMENT.md for where each value comes from.
#
# Everything under "Required" must be set for a working deployment.
# =============================================================================

# --- Required -----------------------------------------------------------------

# Managed PostgreSQL — the source of truth (ARCHITECTURE §2).
# Neon / Supabase / Vercel Postgres. Pooled connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# HS256 signing key for the session JWT (src/lib/auth/session.ts).
# Generate: openssl rand -base64 48
JWT_SECRET=

# Telegram Bot API token from @BotFather. Used for the webhook, photo
# downloads, getChatMember (edit permissions) and login HMAC verification.
TELEGRAM_BOT_TOKEN=

# `secret_token` passed to setWebhook; every delivery is rejected unless the
# X-Telegram-Bot-Api-Secret-Token header matches (src/lib/internal/auth.ts).
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Old channel — the single content source. Posts and edits there are
# reformatted by Gemini and stored in the DB (ARCHITECTURE §4.1).
TELEGRAM_OLD_CHANNEL_ID=-1009876543210

# Frozen main channel — kept only so the webhook can recognise and ignore its
# posts until the channel is deleted (Wave 5 stage 5.7); remove it then.
TELEGRAM_CHANNEL_ID=-1001234567890

# Gemini API key — the direct-Gemini fallback for every text task when KIE is
# unavailable (see KIE_API_KEY). Note: on the free tier gemini-3.1-pro has
# quota 0; only flash models work at all.
GOOGLE_API_KEY=

# Separate, billing-enabled Gemini key for the infographic model
# ("Nano Banana Pro"). Falls back to GOOGLE_API_KEY when unset, but that model
# is not available on the free tier.
GOOGLE_API_KEY_NANO_BANANA=

# KIE.ai API key — recipe image + infographic generation
# (POST /api/recipes/generate-image, /generate-infographic), and both text
# surfaces used by the JSON text tasks (see AI_MODEL_* below). The image
# routes return 500 without it; the text tasks fall back to direct Gemini
# instead. https://kie.ai
KIE_API_KEY=

# Vercel Blob read/write token — recipe images (ARCHITECTURE §5).
# Read implicitly by `@vercel/blob`'s `put()`; on Vercel it is injected by the
# Blob store integration, so set it by hand only for local development.
BLOB_READ_WRITE_TOKEN=

# Shared secret for the machine-to-machine surface: /api/internal/* (called by
# api-python) and manual /api/cron/* triggering. Must equal the api-python
# INTERNAL_API_SECRET. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# Bearer key for the read-only MCP server at /api/mcp (external AI agents).
# One static key shared with the family; the route fails closed when unset.
# Generate: openssl rand -hex 32
MCP_SHARED_KEY=

# Bot username the Telegram Login Widget is rendered for (no @).
# Public by design — it ships to the browser.
NEXT_PUBLIC_TELEGRAM_BOT=your_bot_username

# --- Cron ---------------------------------------------------------------------

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to the scheduled
# GET /api/cron/reconcile (see vercel.json). Set it in the Vercel project;
# without it the cron run is rejected unless INTERNAL_API_SECRET is used.
CRON_SECRET=

# Base URL of the deployed api-python function (with or without the trailing
# /reconcile). Optional: when unset, the cron skips the MTProto history pass.
# PYTHON_RECONCILE_URL=https://your-reconcile-function.vercel.app

# --- Optional -----------------------------------------------------------------

# Pino log level. Defaults to `debug` in development, `info` otherwise.
# LOG_LEVEL=info

# Override the KIE model id used for recipe images / infographics. Both
# default to `gpt-image-2-text-to-image` (typography leader, 4x cheaper than
# nano-banana-pro). Fall back to the nano-banana family here if GPT Image 2's
# Hebrew text rendering disappoints in practice.
# KIE_IMAGE_MODEL=nano-banana-2
# KIE_INFOGRAPHIC_MODEL=nano-banana-pro

# Override the provider+model assigned to a specific task, as `provider:model`
# (provider is `gemini` or `kie`). See src/lib/ai/models.ts for defaults:
# kie:gpt-5-6-luna for the recipe-writing tasks (reformat / suggest /
# refine), kie:gemini-3-7-flash for optimize-steps and the menu agent. All
# text tasks use JSON-schema structured output on every surface; a `kie:`
# assignment picks its surface by model family (GPT ids → the OpenAI
# Responses proxy, Gemini ids → the native Gemini proxy; KIE Gemini ids use
# dashes, not dots, and that surface only carries the flash family). Direct
# Google is free-tier: gemini-3.1-pro has quota 0 and flash 503s/hangs under
# load caused prod 504s. kie assignments auto-fall back to direct Gemini on
# any KIE failure. A bare model name with no `provider:` prefix is
# back-compat for the pre-hybrid config and is treated as `gemini:<model>`.
# AI_MODEL_REFORMAT=kie:gpt-5-6-luna
# AI_MODEL_SUGGEST=kie:gpt-5-6-luna
# AI_MODEL_REFINE=kie:gpt-5-6-luna
# AI_MODEL_OPTIMIZE_STEPS=kie:gemini-3-7-flash
# AI_MODEL_MENU_AGENT=kie:gemini-3-7-flash

# NODE_ENV and VERCEL_GIT_COMMIT_SHA are also read (logger, dev-only branches)
# but are supplied by Next.js / Vercel — do not set them here.

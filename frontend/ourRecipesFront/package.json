{
  "name": "recipe-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev -p 80",
    "build": "prisma generate && node scripts/applyTimerPushSchema.mjs --on-deploy && next build",
    "start": "next start -p 80",
    "lint": "next lint",
    "postinstall": "prisma generate || echo 'Prisma generate skipped'",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest --watch",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "backfill:structured": "tsx scripts/backfillStructuredRecipes.ts",
    "mobile:build": "node scripts/buildMobile.mjs",
    "mobile:sync": "npm run mobile:build && cap sync && node scripts/configureMobile.mjs",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "push:keys": "node scripts/setupTimerPush.mjs",
    "push:schema": "node scripts/applyTimerPushSchema.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capacitor/local-notifications": "8.3.1",
    "@google/genai": "^1.30.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@react-google-maps/api": "^2.20.6",
    "@types/leaflet": "^1.9.8",
    "@vercel/blob": "^2.8.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.15.0",
    "html2canvas": "^1.4.1",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "mcp-handler": "^2.1.1",
    "next": "14.2.35",
    "pg": "^8.13.1",
    "pino": "^10.1.0",
    "prisma": "^7.0.0",
    "react": "^18",
    "react-dom": "^18",
    "react-leaflet": "^4.2.1",
    "tailwind-merge": "^2.5.5",
    "web-push": "3.6.7",
    "workflow": "5.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.11.10",
    "@types/web-push": "3.6.4",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.0.13",
    "autoprefixer": "^10.4.20",
    "dotenv": "^17.2.3",
    "esbuild": "0.25.12",
    "eslint": "^8.57.1",
    "eslint-config-next": "^16.0.3",
    "fake-indexeddb": "6.2.4",
    "jsdom": "^24.0.0",
    "pino-pretty": "^13.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.20.6",
    "typescript": "5.7.2",
    "vitest": "^4.0.13",
    "vitest-mock-extended": "^3.1.0"
  }
}
